{
  "envDefinition": {
    "action": "create_or_replace",
    "content": {
      "inventory": {},
      "envTemplate": {
        "name": "<business-template-name>",
        "artifact": "<business-template-artifact>:<version>",
        "additionalTemplateVariables": {
          "<variable>": "<value>"
        },
        "envSpecificParamsets": {
          "<namespace>": [
            "<paramset-name>"
          ]
        },
        "sharedMasterCredentialFiles": [
          "<shared-credentials-file>"
        ]
      }
    }
  },
  "paramSets": [
    {
      "action": "create_or_replace",
      "place": "env",
      "content": {
        "name": "<paramset-name>",
        "version": 1,
        "parameters": {
          "<PARAMETER>": "<value>"
        }
      }
    }
  ],
  "credentials": [
    {
      "action": "create_or_replace",
      "place": "env",
      "name": "<shared-credentials-file>",
      "content": {
        "<cred-id>": {
          "type": "usernamePassword",
          "data": {
            "username": "<username>",
            "password": "<password>"
          }
        }
      }
    }
  ]
}
