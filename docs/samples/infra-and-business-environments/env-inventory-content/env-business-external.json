{
  "envDefinition": {
    "action": "create_or_replace",
    "content": {
      "inventory": {
        "tenantName": "<tenant-name>",
        "noCmdbVersion": "v2"
      },
      "envTemplate": {
        "name": "<business-template-name>",
        "artifact": "<business-template-artifact>:<version>",
        "additionalTemplateVariables": {
          "use_env_prefix": true
        },
        "sharedTemplateVariables": [
          "<ci-vars>",
          "<feature-toggles>"
        ],
        "sharedMasterCredentialFiles": [
          "<ci-creds>"
        ]
      }
    }
  },
  "credentials": [
    {
      "action": "create_or_replace",
      "place": "env",
      "name": "<ci-creds>",
      "content": {
        "<cred-id>": {
          "type": "external",
          "create": true,
          "secretStore": "default_store",
          "remoteRefPath": "<cluster>/<env>",
          "properties": [
            {
              "name": "username"
            },
            {
              "name": "password"
            }
          ]
        }
      }
    }
  ]
}
