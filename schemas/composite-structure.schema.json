{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Composite Structure Definition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Primary identifier for the Composite structure"
    },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "title": "Namespace Baseline",
          "description": "Baseline defined as a simple namespace",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the baseline namespace"
            },
            "type": {
              "type": "string",
              "description": "Type of the baseline component",
              "enum": [
                "namespace"
              ]
            }
          },
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "BG Domain Baseline",
          "description": "Baseline defined as a Blue-Green Domain",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the BG Domain"
            },
            "type": {
              "type": "string",
              "description": "Type of the baseline component",
              "enum": [
                "bgdomain"
              ]
            }
          },
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "satellites": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Namespace Satellite",
            "description": "Satellite defined as a simple namespace",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the satellite component"
              },
              "type": {
                "type": "string",
                "description": "Type of the satellite component",
                "enum": [
                  "namespace"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "title": "BG Domain Satellite",
            "description": "Satellite defined as a Blue-Green Domain",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the BG Domain"
              },
              "type": {
                "type": "string",
                "description": "Type of the satellite component",
                "enum": [
                  "bgdomain"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "List of satellite components"
    }
  },
  "required": [
    "name",
    "baseline"
  ],
  "additionalProperties": false
}
