<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>sample-app</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>qubership-envgene</name>
      <url>https://maven.pkg.github.com/Netcracker/qubership-envgene</url>
    </repository>
  </distributionManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.3</version>
        <executions>
          <execution>
            <id>deploy-descriptor</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <configuration>
              <file>${project.basedir}/dd.json</file>
              <groupId>com.example</groupId>
              <artifactId>sample-app</artifactId>
              <version>1.0.0</version>
              <packaging>json</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-chart</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <configuration>
              <file>${project.basedir}/sample-chart-1.0.0.tgz</file>
              <groupId>com.example</groupId>
              <artifactId>sample-chart</artifactId>
              <version>1.0.0</version>
              <packaging>tgz</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
