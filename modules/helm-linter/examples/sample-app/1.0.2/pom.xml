<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>sample-app</artifactId>
  <version>1.0.2</version>
  <packaging>pom</packaging>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>qubership-envgene</name>
      <url>https://maven.pkg.github.com/Netcracker/qubership-envgene</url>
    </repository>
  </distributionManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.3</version>
        <executions>
          <execution>
            <id>deploy-sample-alpha</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/dd.json</file>
              <groupId>com.example</groupId>
              <artifactId>sample-alpha</artifactId>
              <version>1.0.2</version>
              <packaging>json</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-alpha-chart</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-alpha-chart-1.0.2.tgz</file>
              <groupId>com.example</groupId>
              <artifactId>sample-alpha-chart</artifactId>
              <version>1.0.2</version>
              <packaging>tgz</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-beta</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-beta-dd.json</file>
              <groupId>com.example</groupId>
              <artifactId>sample-beta</artifactId>
              <version>1.0.2</version>
              <packaging>json</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-beta-chart</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-beta-chart-1.0.2.tgz</file>
              <groupId>com.example</groupId>
              <artifactId>sample-beta-chart</artifactId>
              <version>1.0.2</version>
              <packaging>tgz</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-delta</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-delta-dd.json</file>
              <groupId>com.example</groupId>
              <artifactId>sample-delta</artifactId>
              <version>1.0.2</version>
              <packaging>json</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-delta-chart</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-delta-chart-1.0.2.tgz</file>
              <groupId>com.example</groupId>
              <artifactId>sample-delta-chart</artifactId>
              <version>1.0.2</version>
              <packaging>tgz</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-gamma</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-gamma-dd.json</file>
              <groupId>com.example</groupId>
              <artifactId>sample-gamma</artifactId>
              <version>1.0.2</version>
              <packaging>json</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
          <execution>
            <id>deploy-sample-gamma-chart</id>
            <phase>deploy</phase>
            <goals><goal>deploy-file</goal></goals>
            <configuration>
              <file>${project.basedir}/sample-gamma-chart-1.0.2.tgz</file>
              <groupId>com.example</groupId>
              <artifactId>sample-gamma-chart</artifactId>
              <version>1.0.2</version>
              <packaging>tgz</packaging>
              <repositoryId>github</repositoryId>
              <url>${project.distributionManagement.repository.url}</url>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
